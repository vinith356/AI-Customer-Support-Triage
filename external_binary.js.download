{name:"IS_INF",args:"numeric_expr",description:"Returns TRUE if the value is positive or negative infinity. Returns NULL for NULL inputs."},{name:"IS_NAN",args:"numeric_expr",description:"Returns TRUE if the value is a NaN value. Returns NULL for NULL inputs."},{name:"IS_SIMPLE",args:"graph_path",description:"Returns TRUE if <graph_path> has no repeated node, or if the only repeated nodes are its first and last node, otherwise returns FALSE. Returns NULL if <graph_path> is NULL.",url:"https://cloud.google.com/bigquery/docs/reference/standard-sql/graph-gql-functions#is_simple"},
{name:"IS_TRAIL",args:"graph_path",description:"Returns TRUE if <graph_path> has no repeating edge, otherwise returns FALSE. Returns NULL if <graph_path> is NULL.",url:"https://cloud.google.com/bigquery/docs/reference/standard-sql/graph-gql-functions#is_trail"},{name:"JSON_ARRAY",args:"[value][, ...]",description:"Creates a JSON array from zero or more SQL values.",url:(a=this.docsUrls)==null?void 0:a.CONSOLE__BIGQUERY_DOCS_REFERENCE_STANDARD_SQL_JSON_FUNCTIONS_JSON_ARRAY},{name:"JSON_ARRAY_APPEND",
